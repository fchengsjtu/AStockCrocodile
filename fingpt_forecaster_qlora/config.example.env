# Copy to config.env and edit if needed.
# Database defaults are read from ../env.txt when present.

# FinGPT-Forecaster is commonly published as a LoRA adapter over Llama-2-7B-chat.
# Use a local model path when HuggingFace access is slow or gated.
BASE_MODEL=NousResearch/Llama-2-7b-chat-hf
FINGPT_FORECASTER_ADAPTER=FinGPT/fingpt-forecaster_dow30_llama2-7b_lora
# Optional mirror when huggingface.co is unreachable.
# HF_ENDPOINT=https://hf-mirror.com
# Set to 1 if the FinGPT adapter is unavailable and you want to train a fresh LoRA adapter.
NO_FORECASTER_ADAPTER=0
# Smoke mode defaults to a smaller open model to verify the pipeline without Llama2 authorization.
SMOKE_USE_SMALL_MODEL=1
SMOKE_BASE_MODEL=Qwen/Qwen2.5-0.5B-Instruct
SMOKE_NO_FORECASTER_ADAPTER=1
SMOKE_MAX_SEQ_LENGTH=2048
SMOKE_DATA_DIR=fingpt_forecaster_qlora/data/smoke
SMOKE_OUTPUT_DIR=fingpt_forecaster_qlora/runs/smoke-qwen-0.5b

OUTPUT_DIR=fingpt_forecaster_qlora/runs/astock-fingpt-forecaster-qlora
DATA_DIR=fingpt_forecaster_qlora/data
STAT_TYPE=short_term_surge_3d_20pct

DAILY_WINDOW=55
WEEKLY_WINDOW=55
TRAIN_START_DATE=20100101
TRAIN_END_DATE=20251231
VALID_RATIO=0.2
NEGATIVE_RATIO=1.0
MIN_SUCCESS_RATE=0.40

MAX_SEQ_LENGTH=4096
EPOCHS=1
LEARNING_RATE=2e-4
BATCH_SIZE=1
GRADIENT_ACCUMULATION_STEPS=8
LORA_R=16
LORA_ALPHA=32
LORA_DROPOUT=0.05
